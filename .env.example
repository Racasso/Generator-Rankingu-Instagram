# Copy to .env and add your Apify token there. Never commit .env.
APIFY_TOKEN=
APIFY_POSTS_ACTOR_ID=apify/instagram-post-scraper
APIFY_PROFILE_ACTOR_ID=apify/instagram-profile-scraper
APIFY_MAX_RUN_COST_USD=0.50
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=creator_ranker
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
